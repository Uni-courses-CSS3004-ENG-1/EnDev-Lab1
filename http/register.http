### Tutoring marketplace — sign up, see the token, and who am I (IntelliJ HTTP Client)
#
# 1. docker compose up -d
# 2. mvn spring-boot:run          (dev profile, port 8080)
# 3. Run this file with "Run All Requests in File". Every run makes new accounts
#    ({{$timestamp}} keeps the username and email unique), so it passes again and again.
#
# The sign-up requests print the new token and its decoded payload in the Run tool window
# (client.log), so you can see what the server signed: iss, sub, roles, iat, exp.
# The payload is only base64url: anyone can read it, which is why it holds no email or password.
#
# Stored for the later requests:
#   newStudentToken, newStudentUsername, newStudentEmail
#   newTutorToken,   newTutorUsername,   newTutorId

@host = http://localhost:8080


### 1. Sign up as a STUDENT -> 201, a token like login's, and print it
POST {{host}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: http-register-student

{
  "username": "madina-{{$timestamp}}",
  "password": "correct-horse",
  "role": "STUDENT",
  "name": "Madina Sultan",
  "email": "madina-{{$timestamp}}@example.com"
}

> {%
    // base64url -> text, by hand, so it works in any HTTP Client version
    function decode(part) {
        const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
        let bits = 0, value = 0, text = "";
        for (const c of part) {
            value = (value << 6) | alphabet.indexOf(c);
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                text += String.fromCharCode((value >> bits) & 0xff);
                value &= (1 << bits) - 1;
            }
        }
        return JSON.parse(text);
    }

    client.test("201 Created", () => client.assert(response.status === 201, "status " + response.status));
    client.test("Location is my account", () =>
        client.assert(response.headers.valueOf("Location") === "/api/v1/account"));
    client.test("tokenType Bearer, expiresIn 900", () =>
        client.assert(response.body.tokenType === "Bearer" && response.body.expiresIn === 900));
    client.test("no password in the response", () => client.assert(response.body.password === undefined));

    const token = response.body.accessToken;
    const [header, payload] = token.split(".");
    client.global.set("newStudentToken", token);
    client.log("accessToken  = " + token);
    client.log("header       = " + JSON.stringify(decode(header)));
    client.log("payload      = " + JSON.stringify(decode(payload)));

    const claims = decode(payload);
    client.test("HS256", () => client.assert(decode(header).alg === "HS256"));
    client.test("issuer is tutoring", () => client.assert(claims.iss === "tutoring", claims.iss));
    client.test("roles claim is STUDENT, without ROLE_", () => client.assert(claims.roles.join() === "STUDENT"));
    client.test("lives 15 minutes", () => client.assert(claims.exp - claims.iat === 900));
    client.test("no email in the token", () => client.assert(JSON.stringify(claims).indexOf("@") === -1));
    client.global.set("newStudentUsername", claims.sub);
%}


### 2. Who am I, with the new token -> 200, the new name, ROLE_STUDENT
GET {{host}}/api/me
Authorization: Bearer {{newStudentToken}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "status " + response.status));
    client.test("username from the token", () =>
        client.assert(response.body.username === client.global.get("newStudentUsername")));
    client.test("ROLE_STUDENT only", () => client.assert(response.body.authorities.join() === "ROLE_STUDENT"));
%}


### 3. My profile -> 200, name and email from the student row, no password hash
GET {{host}}/api/v1/account
Authorization: Bearer {{newStudentToken}}

> {%
    client.global.set("newStudentEmail", response.body.email);
    client.test("200 OK", () => client.assert(response.status === 200, "status " + response.status));
    client.test("role STUDENT, name Madina Sultan", () =>
        client.assert(response.body.role === "STUDENT" && response.body.name === "Madina Sultan"));
    client.test("linked to a student row, not a tutor row", () =>
        client.assert(response.body.studentId && response.body.tutorId === null));
    client.test("no password or hash", () =>
        client.assert(response.body.password === undefined && response.body.passwordHash === undefined));
%}


### 4. The new account logs in with its password -> 200
POST {{host}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "{{newStudentUsername}}",
  "password": "correct-horse"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, "status " + response.status));
    client.log("login token  = " + response.body.accessToken);
%}


### 5. Sign up as a TUTOR -> 201, print the token; roles claim is TUTOR
POST {{host}}/api/v1/auth/register
Content-Type: application/json
X-Correlation-Id: http-register-tutor

{
  "username": "ruslan-{{$timestamp}}",
  "password": "teach-biology",
  "role": "TUTOR",
  "name": "Ruslan Ospanov",
  "email": "ruslan-{{$timestamp}}@example.com",
  "subject": "Biology",
  "hourlyRate": 20.00,
  "bio": "Cells, genes and ecosystems, with a drawing for every idea."
}

> {%
    function decode(part) {
        const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
        let bits = 0, value = 0, text = "";
        for (const c of part) {
            value = (value << 6) | alphabet.indexOf(c);
            bits += 6;
            if (bits >= 8) {
                bits -= 8;
                text += String.fromCharCode((value >> bits) & 0xff);
                value &= (1 << bits) - 1;
            }
        }
        return JSON.parse(text);
    }

    client.test("201 Created", () => client.assert(response.status === 201, "status " + response.status));
    const token = response.body.accessToken;
    const claims = decode(token.split(".")[1]);
    client.global.set("newTutorToken", token);
    client.global.set("newTutorUsername", claims.sub);
    client.log("accessToken  = " + token);
    client.log("payload      = " + JSON.stringify(claims));
    client.test("roles claim is TUTOR", () => client.assert(claims.roles.join() === "TUTOR"));
%}


### 6. The tutor's profile -> 200, subject, price and bio from the tutor row
GET {{host}}/api/v1/account
Authorization: Bearer {{newTutorToken}}

> {%
    client.global.set("newTutorId", response.body.tutorId);
    client.test("200 OK", () => client.assert(response.status === 200, "status " + response.status));
    client.test("role TUTOR, Biology at 20", () =>
        client.assert(response.body.role === "TUTOR" && response.body.subject === "Biology" &&
            response.body.hourlyRate === 20));
    client.test("linked to a tutor row", () => client.assert(response.body.tutorId && response.body.studentId === null));
%}


### 7. The new tutor is in the public catalogue -> 200 with no token, and no email in it
GET {{host}}/api/v1/tutors

> {%
    const me = response.body.find(t => t.id === client.global.get("newTutorId"));
    client.test("200 OK without a token", () => client.assert(response.status === 200, "status " + response.status));
    client.test("the new tutor is listed with the bio", () =>
        client.assert(me && me.name === "Ruslan Ospanov" && me.bio.startsWith("Cells")));
    client.test("starts with 0 lessons taught", () => client.assert(me.lessonsTaught === 0));
    client.test("no emails in the public list", () => client.assert(JSON.stringify(response.body).indexOf("@") === -1));
%}


### ─── What sign-up refuses ───


### 8. Username already taken (the dev user aliya) -> 409 DUPLICATE, nothing written
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "aliya",
  "password": "correct-horse",
  "role": "STUDENT",
  "name": "Another Aliya",
  "email": "another-aliya-{{$timestamp}}@example.com"
}

> {%
    client.test("409", () => client.assert(response.status === 409, "status " + response.status));
    client.test("code DUPLICATE", () => client.assert(response.body.code === "DUPLICATE"));
    client.test("username already taken: aliya", () =>
        client.assert(response.body.message === "username already taken: aliya", response.body.message));
    client.test("no token issued", () => client.assert(response.body.accessToken === undefined));
%}


### 9. Email already taken (request 1's) -> 409 DUPLICATE, no account written
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "madina-copy-{{$timestamp}}",
  "password": "correct-horse",
  "role": "STUDENT",
  "name": "Madina Copy",
  "email": "{{newStudentEmail}}"
}

> {%
    client.test("409", () => client.assert(response.status === 409, "status " + response.status));
    client.test("email already exists", () =>
        client.assert(response.body.message.startsWith("email already exists:"), response.body.message));
%}


### 10. Password shorter than 8 -> 400 VALIDATION
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "short-{{$timestamp}}",
  "password": "short",
  "role": "STUDENT",
  "name": "Short Password",
  "email": "short-{{$timestamp}}@example.com"
}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
    client.test("password size must be between 8 and 72", () =>
        client.assert(response.body.message === "password size must be between 8 and 72", response.body.message));
%}


### 11. A role that does not exist -> 400; you cannot sign yourself up as ADMIN
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "boss-{{$timestamp}}",
  "password": "correct-horse",
  "role": "ADMIN",
  "name": "Wants Admin",
  "email": "boss-{{$timestamp}}@example.com"
}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
    client.test("role must be STUDENT or TUTOR", () =>
        client.assert(response.body.message === "role must be STUDENT or TUTOR", response.body.message));
%}


### 12. A tutor without a subject -> 400, and neither the tutor row nor the account is written
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "nosubject-{{$timestamp}}",
  "password": "correct-horse",
  "role": "TUTOR",
  "name": "No Subject",
  "email": "nosubject-{{$timestamp}}@example.com",
  "hourlyRate": 15
}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
    client.test("subject is required for a tutor", () =>
        client.assert(response.body.message === "subject is required for a tutor", response.body.message));
%}


### 13. Capital letters and spaces in the username -> 400
POST {{host}}/api/v1/auth/register
Content-Type: application/json

{
  "username": "Madina Sultan",
  "password": "correct-horse",
  "role": "STUDENT",
  "name": "Madina Sultan",
  "email": "spaces-{{$timestamp}}@example.com"
}

> {%
    client.test("400", () => client.assert(response.status === 400, "status " + response.status));
    client.test("names the username rule", () =>
        client.assert(response.body.message.startsWith("username must be 3-32 characters"), response.body.message));
%}
